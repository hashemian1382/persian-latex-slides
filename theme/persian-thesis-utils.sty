%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 5. Logos
%%
%% \PTlogofile{figures/logos/sharif.pdf}  — path *with* extension, relative to
%% main.tex.  If the file is missing, a neutral vector emblem is drawn instead,
%% so the template always compiles out of the box.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\gdef\PT@logofile{}
\gdef\PT@logofiletwo{}
\newcommand{\PTlogofile}[1]{\gdef\PT@logofile{#1}}
\newcommand{\PTsecondlogofile}[1]{\gdef\PT@logofiletwo{#1}}

\newcommand{\PT@drawlogo}[2]{% #1 = file, #2 = height
  \IfFileExists{#1}{\includegraphics[height=#2,keepaspectratio]{#1}}%
                   {\PTemblem{#2}}%
}
\newcommand{\PTinsertlogo}[1][1.85cm]{%
  \PTifempty{\PT@logofile}{\PTemblem{#1}}{\PT@drawlogo{\PT@logofile}{#1}}%
}
\newcommand{\PTinsertsecondlogo}[1][1.85cm]{%
  \PTifempty{\PT@logofiletwo}{}{\PT@drawlogo{\PT@logofiletwo}{#1}}%
}

% Neutral fallback emblem (no external file needed).  #1 = height.
\newcommand{\PTemblem}[1]{%
  \resizebox{!}{#1}{%
    \begin{tikzpicture}[line join=round,line cap=round,x=1mm,y=1mm]
      \useasboundingbox (-11,-11) rectangle (11,11);
      \draw[PTprimary,line width=1.1pt] (0,0) circle (10.2);
      \draw[PTprimary!30,line width=0.5pt] (0,0) circle (8.6);
      % open book
      \fill[PTprimary!85] (-5.6,-1.9) -- (0,-0.5) -- (5.6,-1.9)
                       -- (5.6,-5.0) -- (0,-3.6) -- (-5.6,-5.0) -- cycle;
      \draw[PTpaper,line width=0.4pt] (0,-0.6) -- (0,-3.7);
      % graduation cap
      \fill[PTaccent] (0,5.4) -- (6.0,2.5) -- (0,-0.4) -- (-6.0,2.5) -- cycle;
      \draw[PTaccent,line width=0.7pt] (4.2,3.5) -- (4.2,0.7);
      \fill[PTaccent] (4.2,0.6) circle (0.75);
    \end{tikzpicture}%
  }%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 6. Decorative primitives
%%
%% These are drawn with TikZ on purpose.  A TikZ picture has *physical*
%% coordinates, so the accent stub and the filled part of the progress bar sit
%% on the right-hand side no matter how the surrounding paragraph direction is
%% resolved.  Both macros return a single \hbox, never a paragraph, so they are
%% safe inside beamer head/foot templates.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% \PTtitlerule{<width>}
%   A hairline whose right-hand end carries a thicker accent stub.
\newcommand{\PTtitlerule}[1]{%
  \begingroup
  \PT@rw=#1\relax
  \PT@ra=\dimexpr.5\PTrulethick-.5\PTrulethin\relax   % hairline bottom
  \PT@rb=\dimexpr.5\PTrulethick+.5\PTrulethin\relax   % hairline top
  \PT@rc=\dimexpr\PT@rw-\PTaccentlen\relax            % stub start
  \ifdim\PT@rc<\z@ \PT@rc=\z@ \fi
  \nointerlineskip
  \hbox{%
    \begin{tikzpicture}
      \useasboundingbox (0pt,0pt) rectangle (\the\PT@rw,\the\PTrulethick);
      \fill[PTline]   (0pt,\the\PT@ra) rectangle (\the\PT@rw,\the\PT@rb);
      \fill[PTaccent] (\the\PT@rc,0pt) rectangle (\the\PT@rw,\the\PTrulethick);
    \end{tikzpicture}%
  }%
  \endgroup
}

% \PThairline[<width>] : a plain hairline (direction-neutral, so a rule is fine).
\newcommand{\PThairline}[1][\linewidth]{%
  {\color{PTline}\rule{#1}{\PTrulethin}}%
}

% \PTaccentstub[<width>] : a short accent dash, used centred on divider frames.
\newcommand{\PTaccentstub}[1][1.5cm]{%
  {\color{PTaccent}\rule{#1}{\PTrulethick}}%
}

% \PTprogressbar{<height>}
%   Full-width bar; the elapsed part grows from the right edge, i.e. it follows
%   the reading direction of the presentation.
\newcommand{\PTprogressbar}[1]{%
  \begingroup
  \PT@pbdone=\z@
  \@ifundefined{inserttotalframenumber}{}{%
    \ifnum\inserttotalframenumber>\z@
      \PT@pbdone=\dimexpr\paperwidth/\inserttotalframenumber*\insertframenumber\relax
    \fi}%
  \ifdim\PT@pbdone>\paperwidth \PT@pbdone=\paperwidth \fi
  \ifdim\PT@pbdone<\z@ \PT@pbdone=\z@ \fi
  \PT@pbtodo=\dimexpr\paperwidth-\PT@pbdone\relax
  \PT@rw=#1\relax
  \usebeamercolor{progress bar}%
  \nointerlineskip
  \hbox{%
    \begin{tikzpicture}
      \useasboundingbox (0pt,0pt) rectangle (\the\paperwidth,\the\PT@rw);
      \fill[bg] (0pt,0pt)            rectangle (\the\paperwidth,\the\PT@rw);
      \fill[fg] (\the\PT@pbtodo,0pt) rectangle (\the\paperwidth,\the\PT@rw);
    \end{tikzpicture}%
  }%
  \endgroup
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 7. Small text helpers available in the slides
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% \hl{...}     strong inline highlight (accent colour, bold)
% \soft{...}   de-emphasised inline text
% \term{...}   a technical term (primary colour, semibold)
% \PTsep       a thin bullet used as an inline separator
\newcommand{\hl}[1]{{\usebeamerfont*{PT highlight}\color{PTaccentdark}#1}}
\newcommand{\soft}[1]{{\color{PTmuted}#1}}
\newcommand{\term}[1]{{\usebeamerfont*{PT term}\color{PTprimary}#1}}
\newcommand{\PTsep}{\,{\color{PTline}\rule[.28ex]{.42em}{.42em}}\,}

\endinput
