%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%  persian-thesis-utils.sty
%%  Low-level helpers for the "PersianThesis" beamer theme:
%%  lengths, direction-safe wrappers, metadata fields, localisable labels,
%%  logo handling and small decorative primitives.
%%
%%  NOTE ON BIDIRECTIONALITY
%%  ------------------------
%%  xepersian/bidi is loaded *after* this package (it must always be the last
%%  package in the preamble).  Therefore nothing here may call \lr, \rl, \setLTR
%%  at *load* time; they are only used inside macro bodies, i.e. at typesetting
%%  time, and always guarded with \@ifundefined so that the theme also survives
%%  a purely LTR test compilation.
%%
%%  The whole theme deliberately avoids \raggedright / \raggedleft in RTL
%%  material: a one-line paragraph is flushed to the *start* of the line by
%%  \parfillskip, which is direction-correct under bidi, whereas the ragged
%%  commands are not reliably mirrored.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{persian-thesis-utils}[2026/08/29 v1.0 Persian thesis beamer utilities]

\RequirePackage{etoolbox}
\RequirePackage{graphicx}
\RequirePackage{tikz}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 1. Lengths
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newlength{\PTmargin}        \setlength{\PTmargin}{1.05cm}
\newlength{\PTrulethin}      \setlength{\PTrulethin}{0.5pt}
\newlength{\PTrulethick}     \setlength{\PTrulethick}{1.7pt}
\newlength{\PTaccentlen}     \setlength{\PTaccentlen}{0.95cm}
\newlength{\PTprogressht}    \setlength{\PTprogressht}{1.6pt}

% scratch registers used by the progress bar and the rules
\newlength{\PT@pbdone}
\newlength{\PT@pbtodo}
\newlength{\PT@rw}
\newlength{\PT@ra}
\newlength{\PT@rb}
\newlength{\PT@rc}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 1b. Theme state switches
%%
%% They live here (the first file loaded) so that every sub-theme can read them.
%% \PTsetup{...} in the preamble is what normally flips them.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newif\ifPTeyebrow      \PTeyebrowtrue      % chapter line above the frame title
\newif\ifPTinsection    \PTinsectionfalse   % set by \AtBeginSection
\newif\ifPTfootline     \PTfootlinetrue     % textual footer
\newif\ifPTprogressfoot \PTprogressfoottrue % progress bar at the bottom edge
\newif\ifPTprogresshead \PTprogressheadfalse% progress bar at the top edge
\newif\ifPTtocnumbers   \PTtocnumberstrue   % numbered entries in the outline
\newif\ifPTsectionpage  \PTsectionpagetrue  % automatic chapter divider frames

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 2. Direction-safe wrappers (resolved at typesetting time)
%%
%%  \PTrl / \PTlr open an explicit right-to-left / left-to-right run.  They try
%%  bidi's short forms first, then its \RLE / \LRE, and finally fall back to
%%  doing nothing at all -- which is what makes the theme survive a plain LTR
%%  test compilation without xepersian.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\PTrl}[1]{%
  \@ifundefined{rl}{\@ifundefined{RLE}{#1}{\RLE{#1}}}{\rl{#1}}%
}
\newcommand{\PTlr}[1]{%
  \@ifundefined{lr}{\@ifundefined{LRE}{#1}{\LRE{#1}}}{\lr{#1}}%
}
\newcommand{\PT@uselatinfont}{\@ifundefined{PTlatinfont}{}{\PTlatinfont}}

% \begin{PTltr} ... \end{PTltr}
%   A *paragraph-level* left-to-right block, for material that is genuinely
%   Latin and several lines long -- a Latin bibliography, an address, a long
%   command line.  Unlike \PTlr it does not build an unbreakable \hbox, so the
%   lines still break and the block may even span a frame break.
%   \PTrtl is the mirror image, needed only inside an outer LTR block.
\newenvironment{PTltr}%
  {\@ifundefined{LTR}{}{\begin{LTR}}}%
  {\@ifundefined{LTR}{}{\end{LTR}}}
\newenvironment{PTrtl}%
  {\@ifundefined{RTL}{}{\begin{RTL}}}%
  {\@ifundefined{RTL}{}{\end{RTL}}}

% \en{...}  ->  a short left-to-right run typeset with the Latin font.
\newcommand{\PTen}[1]{\PTlr{{\PT@uselatinfont #1}}}
\newcommand{\en}[1]{\PTen{#1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 3. Metadata fields
%%
%% \PT@declareinfo{foo} defines the user command \foo{...} and the reader
%% \insertPTfoo (empty by default).  Beamer's own \title, \subtitle, \author,
%% \date and \institute keep working and are reused by the templates.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\PT@declareinfo}[1]{%
  \expandafter\gdef\csname insertPT#1\endcsname{}%
  \expandafter\newcommand\csname #1\endcsname[1]{%
    \expandafter\gdef\csname insertPT#1\endcsname{##1}}%
}

\PT@declareinfo{university}        % دانشگاه
\PT@declareinfo{faculty}           % دانشکده
\PT@declareinfo{department}        % گروه / رشته
\PT@declareinfo{shortuniversity}   % نام کوتاه برای پانویس
\PT@declareinfo{degree}            % کارشناسی / کارشناسی ارشد ...
\PT@declareinfo{major}             % گرایش
\PT@declareinfo{studentid}         % شماره دانشجویی
\PT@declareinfo{supervisor}        % استاد راهنما
\PT@declareinfo{supervisortwo}     % استاد راهنمای دوم
\PT@declareinfo{advisor}           % استاد مشاور
\PT@declareinfo{advisortwo}        % استاد مشاور دوم
\PT@declareinfo{referee}           % استاد داور
\PT@declareinfo{refereetwo}        % استاد داور دوم
\PT@declareinfo{defenseplace}      % محل دفاع
\PT@declareinfo{academicyear}      % سال تحصیلی
\PT@declareinfo{latintitle}        % عنوان انگلیسی پایان‌نامه
\PT@declareinfo{invocation}        % «بسم الله الرحمن الرحیم» یا خالی

% Tests whether a metadata field is empty.
\newcommand{\PTifempty}[3]{\ifdefempty{#1}{#2}{#3}}

% Beamer spells the short forms \title[short]{long} and \author[short]{long}.
% These two commands are the same thing written the way the rest of the metadata
% is written; use them *after* \title / \author.
\newcommand{\shorttitle}[1]{\gdef\insertshorttitle{#1}}
\newcommand{\shortauthor}[1]{\gdef\insertshortauthor{#1}}

